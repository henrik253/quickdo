{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "dayStart": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "dayEnd": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "slackMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            }
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "required": [
          "name",
          "days",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "dayStart",
    "dayEnd",
    "slackMinutes",
    "anchors"
  ],
  "additionalProperties": false,
  "$id": "https://example.com/quickdo/schema/schedule.schema.json"
}
