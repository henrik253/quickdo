{
  "name": "quickdo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard-first todo app that lives in the Dock. JSON data in a private git repo, a science-based daily method built in.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "quickdo": "bin/quickdo"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "QUICKDO_DEV=1 tsx watch src/server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.domain.json",
    "features": "tsx scripts/check-features.ts",
    "schema:build": "tsx scripts/schema-build.ts",
    "privacy": "bash scripts/check-no-pii.sh",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run features && npm run privacy"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^1.14.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "chokidar": "^4.0.0",
    "chrono-node": "^2.10.0",
    "date-fns": "^4.1.0",
    "hono": "^4.13.0",
    "p-queue": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "simple-git": "^3.36.0",
    "ulid": "^3.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.28.0",
    "fast-check": "^3.23.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.0"
  }
}
